# Copy to .env.local and fill in. Never commit real values.
# Every new variable must be added here in the same commit that introduces it.

# --- Space-Track (eval ground truth only) ---------------------------------------------------
# Used to build the evaluation set. MUST NOT be set on the public deployment: the public app
# serves Celestrak data, which needs no authentication. This split keeps the deployment clearly
# inside Space-Track's redistribution terms.
# SPACETRACK_USERNAME=
# SPACETRACK_PASSWORD=

# --- AI Gateway (added at M3) ---------------------------------------------------------------
# AI_GATEWAY_API_KEY=
